# ── Доступ к админке opt-spb.ru ──────────────────────────────────────────────
# НИКОГДА не коммить реальные значения. На GitHub Actions — кладите в Secrets.
OPT_SPB_BASE_URL=https://opt-spb.ru
OPT_SPB_LOGIN=magazim
OPT_SPB_PASSWORD=__положите_пароль_в_secrets__

# ── Claude API (решающий слой матчинга) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Модель для верификации матчей. Opus 4.8 точнее в долгих агентских задачах и в honesty
# (важно для правила ≥95%). Можно временно поставить sonnet ради экономии.
AGENT_MODEL=claude-opus-4-8

# ── Поведение прогона ────────────────────────────────────────────────────────
# safe   — автопривязка матчей ≥95%, создание/спорное → отчёт на согласование
# full   — привязка + создание карточек (картинка обязательна), спорное → отчёт
# dry-run — ничего не меняет на сайте, только парсит/ищет/считает и пишет отчёт-план
AGENT_MODE=full

# Порог автономного действия (0..1). Ниже порога — карточка согласования.
AGENT_CONFIDENCE_THRESHOLD=0.95

# Бюджет времени на один прогон в минутах (для почасового cron оставляйте < 60).
AGENT_TIME_BUDGET_MIN=50

# Максимум тегов за один прогон (0 = без лимита, до исчерпания бюджета времени).
AGENT_MAX_TAGS=0

# headless=true на CI; false — чтобы видеть браузер локально при отладке.
AGENT_HEADLESS=true
