// Схема БД TaskFlow (PostgreSQL). Значения enum совпадают с @taskflow/shared.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  process_lead
  member
}

enum ProjectType {
  project
  process
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum TaskStatus {
  to_do
  in_progress
  on_hold
  blocked
  failed
  done
  canceled
}

enum RecurrenceFreq {
  none
  daily
  weekly
  monthly
  quarterly
  on_date
}

enum AttachmentKind {
  attachment
  completion_proof
}

enum ProofFormat {
  text
  link
  file
}

enum NotificationType {
  assigned
  commented
  status_changed
  due_soon
  mentioned
  added_participant
}

enum PaymentStatus {
  planned
  paid
  canceled
}

model User {
  id               String   @id @default(cuid())
  telegramId       String?  @unique
  telegramUsername String?
  fullName         String
  position         String?
  avatarColor      String?
  role             Role     @default(member)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  functions       Function[]    @relation("FunctionResponsible")
  assignedTasks   Task[]        @relation("TaskAssignee")
  createdTasks    Task[]        @relation("TaskCreator")
  ledProjects     Project[]     @relation("ProjectLead")
  participations  TaskParticipant[]
  comments        Comment[]
  attachments     Attachment[]
  notifications   Notification[]
  activity        ActivityEntry[]
}

model Function {
  id                String   @id @default(cuid())
  name              String
  description       String?
  expectedResult    String?
  parentId          String?
  responsibleUserId String?
  archived          Boolean  @default(false)

  parent      Function?  @relation("FunctionTree", fields: [parentId], references: [id])
  children    Function[] @relation("FunctionTree")
  responsible User?      @relation("FunctionResponsible", fields: [responsibleUserId], references: [id])
  tasks       Task[]
}

model Project {
  id             String      @id @default(cuid())
  type           ProjectType @default(project)
  name           String
  color          String      @default("#5e6ad2")
  leadId         String?
  telegramChatId String?
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  lead  User?  @relation("ProjectLead", fields: [leadId], references: [id])
  tasks Task[]
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  projectId    String
  functionId   String?
  parentTaskId String?
  assigneeId   String?
  creatorId    String
  priority     TaskPriority @default(medium)
  status       TaskStatus   @default(to_do)
  dueAt        DateTime?
  proofRequired Boolean     @default(false)

  recurrenceFreq     RecurrenceFreq @default(none)
  recurrenceInterval Int?
  recurrenceTime     String?
  recurrenceDate     DateTime?

  remindedDayBefore  Boolean @default(false)
  remindedHourBefore Boolean @default(false)

  customFields Json     @default("{}")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id])
  function    Function?         @relation(fields: [functionId], references: [id])
  parent      Task?             @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks    Task[]            @relation("TaskSubtasks")
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User              @relation("TaskCreator", fields: [creatorId], references: [id])
  participants TaskParticipant[]
  comments    Comment[]
  attachments Attachment[]
  notifications Notification[]
  activity    ActivityEntry[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([functionId])
}

model TaskParticipant {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])
}

model Attachment {
  id        String         @id @default(cuid())
  taskId    String
  kind      AttachmentKind @default(attachment)
  format    ProofFormat
  value     String
  authorId  String
  createdAt DateTime       @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  taskId    String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id])
}

model ActivityEntry {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  action    String
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
}

model PaymentEvent {
  id             String         @id @default(cuid())
  title          String
  counterparty   String?
  amount         Float
  currency       String         @default("RUB")
  dueDate        DateTime
  status         PaymentStatus  @default(planned)
  projectId      String?
  recurrenceFreq RecurrenceFreq @default(none)
  createdAt      DateTime       @default(now())
}
