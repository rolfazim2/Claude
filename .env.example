# Скопируйте в .env и при необходимости поменяйте значения.
# Минимум для запуска «из коробки»: ничего менять не обязательно —
# docker compose up -d --build поднимет всё с дефолтами (без Telegram).

# PostgreSQL
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow

# Секрет подписи токенов входа (в проде задайте длинную случайную строку!)
APP_SECRET=change-me-to-a-long-random-string

# Демо-вход «выбором сотрудника» (true/false). В проде можно выключить.
ALLOW_DEMO_LOGIN=true

# Для локальной разработки API (вне docker)
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow

# URL API для фронтенда. ПУСТО = фронтенд ходит на /api того же домена
# (nginx-прокси в веб-контейнере) — отдельная настройка не нужна.
VITE_API_URL=

# AI для описаний (опционально). Без ключа работает умный шаблон.
# CHATPRD_API_KEY=
# ANTHROPIC_API_KEY=

# Telegram-бот и авторизация через Telegram
# BOT_TOKEN=            # токен от @BotFather
# BOT_USERNAME=         # username бота без @ (для deep-link t.me/<username>)
# BOT_SHARED_SECRET=    # общий секрет между API и ботом (любая строка)
# API_URL=http://localhost:3001   # как бот достучится до API (вне docker)
