# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Базовый URL API otask.ru
OTASK_API_BASE=https://api.otask.ru

# Необязательно: общий API-ключ otask по умолчанию.
# Если задан — используется для всех пользователей, которые не привязали свой ключ через /link.
# Для многопользовательского режима оставьте пустым и пусть каждый привязывает свой ключ.
OTASK_API_KEY=

# Куда складывать локальное хранилище (привязки токенов, статусы напоминаний)
DATA_DIR=./data

# Напоминать, если дедлайн наступает в ближайшие N часов
REMINDER_LEAD_HOURS=24

# Как часто опрашивать API на предмет приближающихся дедлайнов (минуты)
REMINDER_POLL_MINUTES=15
