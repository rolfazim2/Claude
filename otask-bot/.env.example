# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Базовый URL API otask.ru
OTASK_API_BASE=https://api.otask.ru

# Общий API-ключ otask (одноаккаунтный режим — один ключ на всех пользователей бота)
OTASK_API_KEY=

# Куда складывать локальное хранилище (подписчики, статусы напоминаний)
DATA_DIR=./data

# Напоминать, если дедлайн наступает в ближайшие N часов
REMINDER_LEAD_HOURS=24

# Как часто опрашивать API на предмет приближающихся дедлайнов (минуты)
REMINDER_POLL_MINUTES=15

# Часовой пояс для отображения дат
TIMEZONE=Europe/Moscow
